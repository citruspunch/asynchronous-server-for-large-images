# OpenCode agent workspace (local tooling, not part of the project)
.opencode/

# Maven build output
target/

# Java bytecode
*.class

# Large ingested masters (pyramids under data/images/0|1 are generated demos)
data/images/*.tif*
*.log

# Original ultra-high-res sources for scripts/import_vips.sh. Multi-GB, never
# committed. The data/images/ pyramids are regenerated from these, so this tree
# holds the only irreplaceable copy — keep it clear of `rm -rf data/images/*`.
data/sources/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Node presentation (deps installable via npm, dist rebuilt via build)
node_modules/
presentation/dist/

# Node project files (not part of the project)
data/images/

# Python bytecode from the offline-validation scripts (they import each other)
__pycache__/